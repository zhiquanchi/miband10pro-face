{
  "device": "Xiaomi Smart Band 10 Pro",
  "screen": { "width": 336, "height": 480, "scale": 3 },
  "style": "dark-data-dashboard",
  "palette": {
    "background": "#04070A",
    "panel": "linear-gradient(180deg, rgba(17,28,31,.90), rgba(8,13,15,.92))",
    "border": "rgba(94,234,212,.14)",
    "accent": "#4FE3C1",
    "accentSoft": "#6FD8C3",
    "text": "#EAF4F4",
    "muted": "#6F8489",
    "sub": "#9FB3B6",
    "sun": "#FFC46B",
    "moon": "#A8C7FA"
  },
  "fonts": {
    "numbers": "\"Avenir Next Condensed\", \"DIN Condensed\", \"Helvetica Neue\"",
    "chinese": "\"PingFang SC\", \"Noto Sans SC\", sans-serif"
  },
  "cards": [
    { "name": "weather", "x": 16, "y": 166, "w": 304, "h": 84, "radius": 14 },
    { "name": "sun", "x": 16, "y": 262, "w": 304, "h": 86, "radius": 14 },
    { "name": "steps", "x": 16, "y": 358, "w": 188, "h": 92, "radius": 14 },
    { "name": "stand", "x": 216, "y": 358, "w": 104, "h": 92, "radius": 14 }
  ],
  "elements": [
