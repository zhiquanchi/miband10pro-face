    { "id": "daylight", "type": "text", "dynamic": false, "x": 220, "y": 272, "w": 86, "h": 13, "sample": "日照 11h03m", "font": "numbers+chinese", "size": 9.5, "color": "#6FD8C3", "align": "right" },
    { "id": "sun_arc", "type": "image", "dynamic": false, "x": 30, "y": 288, "w": 276, "h": 44, "note": "弧线+地平线已烘在底图中，也可用 assets 重建" },
    { "id": "sun_marker", "type": "image", "dynamic": false, "x": 264, "y": 304, "w": 16, "h": 16, "asset": "assets/sun-dot@3x.png", "note": "示例位置对应 15:54，实际当前位置需按时间换算或省略" },
    { "id": "sunrise_time", "type": "text", "dynamic": false, "x": 44, "y": 328, "w": 40, "h": 14, "sample": "06:06", "font": "numbers", "size": 11.5, "weight": 600, "tracking": "0.06em", "color": "#D7E8E5", "align": "left" },
    { "id": "sunset_time", "type": "text", "dynamic": false, "x": 252, "y": 328, "w": 40, "h": 14, "sample": "17:09", "font": "numbers", "size": 11.5, "weight": 600, "tracking": "0.06em", "color": "#D7E8E5", "align": "right" },

