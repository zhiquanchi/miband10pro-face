    { "id": "weather_sub", "type": "text", "dynamic": false, "x": 186, "y": 207, "w": 120, "h": 12, "sample": "湿度 43% · 东风 3 级", "font": "chinese", "size": 9, "color": "#6F8489", "align": "right" },
    { "id": "weather_divider", "type": "rect", "dynamic": false, "x": 202, "y": 183, "w": 1, "h": 50, "color": "rgba(94,234,212,.22)" },

