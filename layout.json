    { "id": "battery_value", "type": "text", "dynamic": true, "binding": "battery", "x": 47, "y": 18, "w": 40, "h": 14, "sample": "76%", "font": "numbers", "size": 11, "weight": 600, "color": "#9FB3B6", "align": "left" },

    { "id": "lunar", "type": "text", "dynamic": false, "x": 180, "y": 14, "w": 140, "h": 16, "sample": "丙午年 · 九月十九", "font": "chinese", "size": 11.5, "color": "#6FD8C3", "align": "right", "note": "静态烘底，换日需重生成" },

    { "id": "time", "type": "text", "dynamic": true, "binding": "time", "x": 14, "y": 34, "w": 232, "h": 94, "sample": "15:54", "font": "numbers", "size": 94, "weight": 700, "color": "linear-gradient(180deg,#FFFFFF 30%,#C9E6E0 100%)", "align": "left" },
    { "id": "weekday_en", "type": "text", "dynamic": true, "binding": "weekday_en", "x": 266, "y": 54, "w": 54, "h": 10, "sample": "WED", "font": "numbers", "size": 9, "weight": 600, "tracking": "0.28em", "color": "#6F8489", "align": "right" },
    { "id": "weekday_cn", "type": "text", "dynamic": true, "binding": "weekday_cn", "x": 266, "y": 68, "w": 54, "h": 26, "sample": "周三", "font": "chinese", "size": 21, "color": "#EAF4F4", "align": "right" },
    { "id": "solar_date", "type": "text", "dynamic": true, "binding": "date", "x": 16, "y": 134, "w": 110, "h": 20, "sample": "10月28日", "font": "chinese", "size": 14, "weight": 600, "color": "#EAF4F4", "align": "left" },
    { "id": "solar_year", "type": "text", "dynamic": true, "binding": "year", "x": 80, "y": 138, "w": 40, "h": 12, "sample": "2026", "font": "numbers", "size": 10, "color": "#6F8489", "align": "left" },
    { "id": "day_of_year", "type": "text", "dynamic": true, "binding": "day_of_year", "x": 262, "y": 138, "w": 58, "h": 12, "sample": "第 301 天", "font": "chinese", "size": 8.5, "color": "#6F8489", "align": "right" },

    { "id": "weather_icon", "type": "image", "dynamic": true, "binding": "weather_icon", "x": 36, "y": 188, "w": 42, "h": 42, "asset": "assets/weather-sun@3x.png" },
