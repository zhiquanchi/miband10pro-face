    { "id": "stand_dots", "type": "element", "dynamic": false, "x": 230, "y": 422, "w": 76, "h": 19, "note": "6×2 圆点，9 个点亮；工具无站立元素时保持静态" },

    { "id": "footer_location", "type": "text", "dynamic": false, "x": 16, "y": 460, "w": 130, "h": 10, "sample": "SHANGHAI · 浦东", "font": "numbers+chinese", "size": 8, "tracking": "0.12em", "color": "rgba(111,132,137,.75)", "align": "left" },
    { "id": "footer_update", "type": "text", "dynamic": true, "x": 240, "y": 460, "w": 80, "h": 10, "sample": "更新 15:54", "font": "chinese", "size": 8, "color": "rgba(111,132,137,.75)", "align": "right" }
  ]
}
