    { "id": "steps_value", "type": "text", "dynamic": true, "binding": "steps", "x": 29, "y": 375, "w": 140, "h": 46, "sample": "8,432", "unit": "步", "font": "numbers", "size": 40, "weight": 600, "color": "#EAF4F4", "align": "left" },
    { "id": "steps_track", "type": "rect", "dynamic": false, "x": 30, "y": 426, "w": 160, "h": 4, "radius": 2, "color": "rgba(94,234,212,.13)" },
    { "id": "steps_fill", "type": "rect", "dynamic": true, "x": 30, "y": 426, "w": 112, "h": 4, "radius": 2, "color": "linear-gradient(90deg,#2FAE95,#4FE3C1)", "note": "工具一般无进度元素，此处仅示意；底图导出时已留空" },
    { "id": "goal", "type": "text", "dynamic": false, "x": 30, "y": 434, "w": 80, "h": 10, "sample": "目标 12,000", "font": "chinese", "size": 8, "color": "#6F8489", "align": "left" },
    { "id": "steps_pct", "type": "text", "dynamic": true, "x": 160, "y": 433, "w": 30, "h": 12, "sample": "70%", "font": "numbers", "size": 9, "weight": 600, "color": "#6FD8C3", "align": "right" },

    { "id": "stand_label", "type": "text", "dynamic": false, "x": 230, "y": 369, "w": 60, "h": 10, "sample": "站立", "font": "chinese", "size": 8.5, "tracking": "0.12em", "color": "#6F8489", "align": "left" },
